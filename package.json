{
  "name": "osint-mapping-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, open-source OSINT tool for mapping target information and visited locations.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "server": "node server/index.js",
    "build": "vite build",
    "build:native": "node scripts/build-native.js",
    "native:assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#111827\" --iconBackgroundColorDark \"#111827\" --splashBackgroundColor \"#111827\" --splashBackgroundColorDark \"#111827\" --logoSplashScale 0.3",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neondatabase/functions": "^0.11.0",
    "@neondatabase/neon-js": "^0.9.0-beta",
    "@supabase/supabase-js": "^2.118.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@xyflow/react": "^12.3.5",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  }
}
