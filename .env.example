# Google Maps credentials — OPTIONAL.
# Leave both blank to launch straight into the app's first-run screen, where
# you can pick OpenStreetMap (no key needed) or Google Maps.
# Fill these in only if you want Google Maps mode. Non-empty values here are
# written into public/app.config.json when the container starts, and the
# first-run screen then skips asking for a key.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Research API server secrets — optional and never copied into frontend config.
# Google Programmable Search — set both values to enable Google web discovery.
# Create a Programmable Search Engine and enable the Custom Search JSON API.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Other web discovery provider keys.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# YouTube video search — OPTIONAL. Create a key in Google Cloud, enable
# YouTube Data API v3, and keep this key on the server only.
YOUTUBE_API_KEY=

# Neon Community Research Hub — public browser settings only.
# Populate these after deploying the services declared in neon.ts.
VITE_NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
VITE_NEON_FUNCTION_ASSETS_BASE_URL=
